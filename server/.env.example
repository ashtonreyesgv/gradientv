# copy this file to .env and fill it in
# .env never gets committed. on Vercel the same names go in
# Project Settings > Environment Variables instead

PORT=4000

# where the database is. local MongoDB while building, the Atlas connection string once that exists
MONGODB_URI=mongodb://127.0.0.1:27017/gradientv

# lets the server read Web Analytics for the client sites (vercel.com > Account Settings > Tokens).
# it can read the whole Vercel account, so it only ever lives here and on Vercel, never in the client
VERCEL_TOKEN=

# the team the projects are under: the part after the project name in a deployment URL,
# like bukascafe-abc123-ashtonreyesgvs-projects.vercel.app
VERCEL_TEAM=ashtonreyesgvs-projects
